# Copy to backend/.env for local overrides. backend/.env is git-ignored: never commit real secrets.
ENVIRONMENT=development
# DATABASE_URL=postgresql+psycopg://user:password@host/dbname   (production)
# JWT_SECRET=<long random string, for example from: python -c "import secrets; print(secrets.token_urlsafe(48))">
# MAX_UPLOAD_MB=10
# ANTHROPIC_API_KEY=<your key>   (needed for the Claude skin gate and full check, see models/claude_check.json)
# Model (default v3; see models/README.md). For model v1:
# MODEL_CONFIG_FILE=lumis_model_config.json
# PHOTO_CHECK_FILE=photo_check.json
# ONNX_THREADS=4                  (default: all cores)
