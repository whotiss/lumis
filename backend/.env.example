# Copy to backend/.env for local overrides. backend/.env is git-ignored: never commit real secrets.
ENVIRONMENT=development
# DATABASE_URL=postgresql+psycopg://user:password@host/dbname   (production)
# JWT_SECRET=<long random string, for example from: python -c "import secrets; print(secrets.token_urlsafe(48))">
# MAX_UPLOAD_MB=10
